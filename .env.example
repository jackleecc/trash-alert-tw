# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron 排程驗證密鑰 (cron-job.org / Cloud Scheduler 授權用)
CRON_SECRET=your-cron-secret-key

# LINE Messaging API (預設 / 汐止 & 台南)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE Messaging API (桃園專用 @039fysvd)
LINE_CHANNEL_ACCESS_TOKEN_TAOYUAN=your-taoyuan-channel-access-token
LINE_CHANNEL_SECRET_TAOYUAN=your-taoyuan-channel-secret

# Optional override for the official realtime truck API endpoint
TRUCK_API_URL=https://api.kcg.gov.tw/api/service/Get/aaf4ce4b-4ca8-43de-bfaf-6dc97e89cac0

# 新北官方網站同輪備援：未設定或精確 true 啟用，明確 false 關閉。
# 2026-10-17 已授權預設啟用；服務時段位置更新／延遲實證仍待取得，見 docs/ntpc-website-backup.md。
NTPC_WEBSITE_BACKUP_ENABLED=true

# 臺南市代理伺服器 (部署於 Cloud Run asia-east1 時不需要設定，主體本身即為台灣 IP)
# TAINAN_PROXY_URL=https://your-tainan-proxy.asia-east1.run.app
# TAINAN_PROXY_SECRET=your-proxy-secret

# 臺南市手機中繼模式 (設為 true 時，雲端排程將略過主動輪詢天眼，純依賴 Android 手機 MacroDroid 轉發通知)
SKIP_TAINAN_POLLING=true
